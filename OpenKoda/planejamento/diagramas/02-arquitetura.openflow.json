            "dsl": {
              "family": "flowchart",
              "version": 1,
              "source": "%% ofk 1\nflowchart down\ntitle: OpenKoda - Tauri escolhido e arquitetura proposta\nicons: off\ngroup Windows {\n  Painel [browser, blue, label: Painel Tauri WebView2]\n  Nucleo [component, blue, label: Nucleo nativo - Rust proposto]\n  CoordenadorIA [component, violet]\n  Politica [diamond, orange]\n  GatewayMCP [component, teal]\n  BrokerHost [component, orange]\n  Vault [cylinder, orange]\n  BancoLocal [cylinder, green]\n  Evidencias [cylinder, green]\n  Parser [component, green]\n}\ngroup KaliWSL {\n  Executor [component, teal]\n  PerfilVerificado [diamond, orange]\n  Ferramenta [component, teal]\n  Spool [cylinder, green]\n}\nModelo [cloud, violet]\nAlvoAutorizado [rect, gray]\nPainel <-> Nucleo : commands e eventos IPC restritos\nNucleo <-> BancoLocal : estado e eventos\nNucleo <-> CoordenadorIA : objetivo e cobertura\nCoordenadorIA <-> Modelo : API e contexto selecionado\nCoordenadorIA -> GatewayMCP : proposta de ferramenta\nGatewayMCP <-> Politica : decidir autoridade\nPolitica -> BrokerHost : grant interno\nBrokerHost <-> Vault : referencias opacas\nBrokerHost -> Executor : ambiente e delegacao\nGatewayMCP <-> Executor : MCP stdio supervisionado\nExecutor -> PerfilVerificado : revalidar antes de iniciar\nPerfilVerificado -> Ferramenta : capacidade permitida\nFerramenta <-> AlvoAutorizado : acesso sob controles\nFerramenta -> Spool : bytes e artefatos\nSpool -> BrokerHost : copiar e verificar\nBrokerHost -> Evidencias : promover com hash\nEvidencias -> Parser : bruto como dados\nParser -> Nucleo : observacao com origem\n",
              "hash": "1yzx1ja",
              "direction": "down",
              "title": "OpenKoda - Tauri escolhido e arquitetura proposta",
              "icons": "off"
            }
