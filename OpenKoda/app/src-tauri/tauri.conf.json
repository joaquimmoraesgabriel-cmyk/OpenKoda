{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenKoda",
  "version": "0.2.0",
  "identifier": "com.openkoda.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "OpenKoda", "width": 1400, "height": 900, "minWidth": 900, "minHeight": 620, "center": true, "zoomHotkeysEnabled": true }],
    "security": {
      "capabilities": ["main-window"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../security-runtime/": "security-runtime/",
      "../docs/avisos/AVISOS.txt": "avisos/AVISOS.txt",
      "../docs/avisos/Prestige-UI-LICENSE.txt": "avisos/Prestige-UI-LICENSE.txt",
      "../docs/avisos/Cindy-LICENSE.txt": "avisos/Cindy-LICENSE.txt",
      "../docs/avisos/Cindy-NOTICE.txt": "avisos/Cindy-NOTICE.txt",
      "../docs/avisos/COPYRIGHT-library.html": "avisos/COPYRIGHT-library.html",
      "../docs/avisos/fontes-MPL.zip": "avisos/fontes-MPL.zip",
      "../scripts/windows_release_recovery.py": "recuperacao/windows_release_recovery.py",
      "../docs/RECUPERACAO-WINDOWS.md": "recuperacao/RECUPERACAO-WINDOWS.md"
    },
    "shortDescription": "Ambiente local para trabalhos de segurança com evidências",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {"allowDowngrades": false, "nsis": {"installMode": "currentUser", "installerIcon": "icons/icon.ico", "uninstallerIcon": "icons/icon.ico", "languages": ["PortugueseBR"], "displayLanguageSelector": false}}
  }
}
